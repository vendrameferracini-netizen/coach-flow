# Supabase público usado no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Modo demonstração local quando Supabase ainda não estiver configurado.
# Em produção, defina como false após conectar Auth e tabelas reais.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_ROLE=coach

# Use somente em rotas server-side seguras ou Edge Functions.
# Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-somente-no-servidor
